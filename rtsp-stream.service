[Unit]
Description=MediaMTX RTSP Camera Stream
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/karla/rtsp
ExecStartPre=/sbin/sysctl -w net.core.rmem_default=1000000
ExecStartPre=/sbin/sysctl -w net.core.rmem_max=1000000
ExecStart=/home/karla/rtsp/mediamtx /home/karla/rtsp/config/mediamtx.yml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
